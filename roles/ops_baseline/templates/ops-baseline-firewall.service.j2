[Unit]
Description=Owned ops-fleet nftables policy
# This is an early-boot firewall: default After=basic.target/sysinit.target can
# form an ordering cycle with networking. Keep explicit shutdown ordering.
DefaultDependencies=no
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft --file /etc/nftables.d/ops-fleet.nft
ExecReload=/usr/sbin/nft --file /etc/nftables.d/ops-fleet.nft
# No ExecStop flush: stopping this unit must not remove firewall protection.

[Install]
WantedBy=multi-user.target
